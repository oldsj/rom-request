# Copy to .env for `make dev`. Development values only: none of these work in production, and
# production gets every secret from its environment (a Kubernetes Secret).
DATABASE_URL=postgres://app:app-dev-only@localhost:54329/app?sslmode=disable
ALLOW_SIGNUP=true
LOG_LEVEL=debug
LISTEN_ADDR=127.0.0.1:8080

# OIDC sign-in, optional (for example Pocket ID). Register the client with the redirect URL below.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:5173/api/auth/oidc/callback
# OIDC_NAME=Pocket ID
# OIDC_ALLOWED_GROUPS=
# OIDC_LIMITED_GROUPS=
# PASSWORD_LOGIN=true

# Integrations, all optional (docs/development.md). Without them the app runs and says what's
# missing.
# PROWLARR_URL=http://localhost:9696
# PROWLARR_API_KEY=
# PROWLARR_CATEGORIES=1000
# PROWLARR_BLOCKED_INDEXERS=BlueRoms
# QBITTORRENT_URL=http://localhost:8081
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=
# QBITTORRENT_CATEGORY=
# QBITTORRENT_SAVE_PATH=/downloads/rom-request
# DOWNLOAD_DIR=/path/to/the/same/downloads/rom-request
# LIBRARY_DIR=/path/to/roms
# LIBRARY_EXCLUDE=bios
# WORKER_INTERVAL=15s
# RomM: ask it to scan a platform folder after each import. The token is a RomM client API
# token (Profile > Client API tokens) with only the tasks.run scope.
# ROMM_URL=http://localhost:8082
# ROMM_API_TOKEN=
# The game catalog (Browse): a Twitch application's credentials, as RomM uses for IGDB.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# CATALOG_PLATFORMS=md=genesis-slash-megadrive
