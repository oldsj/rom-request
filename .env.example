# Copy to .env for `make dev`. Development values only: none of these work in production, and
# production gets every secret from its environment (a Kubernetes Secret).
DATABASE_URL=postgres://app:app-dev-only@localhost:54329/app?sslmode=disable
ALLOW_SIGNUP=true
LOG_LEVEL=debug
LISTEN_ADDR=127.0.0.1:8080

# Integrations, all optional (docs/development.md). Without them the app runs and says what's
# missing.
# PROWLARR_URL=http://localhost:9696
# PROWLARR_API_KEY=
# PROWLARR_CATEGORIES=1000
# QBITTORRENT_URL=http://localhost:8081
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=
# QBITTORRENT_CATEGORY=
# QBITTORRENT_SAVE_PATH=/downloads/rom-request
# DOWNLOAD_DIR=/path/to/the/same/downloads/rom-request
# LIBRARY_DIR=/path/to/roms
# LIBRARY_EXCLUDE=bios
# WORKER_INTERVAL=15s
