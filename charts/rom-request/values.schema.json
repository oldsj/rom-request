{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "config",
    "database",
    "networkPolicy",
    "resources",
    "auth"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "allowSignup": {
          "type": "boolean"
        },
        "sessionTTL": {
          "type": "string",
          "pattern": "^[0-9]+(h|m)$"
        },
        "authRatePerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "trustedProxies": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "imageName": {
              "type": "string",
              "pattern": "@sha256:[a-f0-9]{64}$"
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "caSecret": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passwordLogin",
        "oidc"
      ],
      "properties": {
        "passwordLogin": {
          "type": "boolean"
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "clientId",
            "name",
            "allowedGroups",
            "groupsClaim"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^$|^https://[^\\s/]+"
            },
            "clientId": {
              "type": "string",
              "maxLength": 256
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "allowedGroups": {
              "type": "string",
              "maxLength": 1024
            },
            "groupsClaim": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prowlarr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "categories": {
              "type": "string",
              "pattern": "^$|^[0-9]+(,[0-9]+)*$"
            }
          }
        },
        "qbittorrent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "category": {
              "type": "string"
            },
            "savePath": {
              "type": "string",
              "pattern": "^$|^/"
            }
          }
        },
        "libraryExclude": {
          "type": "string"
        },
        "workerInterval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platforms": {
              "type": "string",
              "pattern": "^$|^[^=,]+=[a-z0-9-]+(,[^=,]+=[a-z0-9-]+)*$"
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "downloads": {
          "type": "object"
        },
        "library": {
          "type": "object"
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "fsGroup": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          }
        },
        "clusterIssuer": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "dnsTo": {
          "type": "array"
        },
        "databaseTo": {
          "type": "array"
        },
        "databasePort": {
          "type": "integer"
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "memory"
          ]
        }
      }
    }
  }
}
